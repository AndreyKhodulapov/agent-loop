# Copy to ~/.agent-loop/.env. A repository profile (loop.toml) and CLI flags override these values.

# Language of documentation, specifications and code comments: ru | en
LOOP_DOC_LANG=ru

LOOP_MODEL_PLANNER=opus
# Implementer and fixer
LOOP_MODEL_IMPLEMENTER=opus
# Plan critic and reviewer
LOOP_MODEL_CRITIC=opus
LOOP_EFFORT_PLANNER=high
LOOP_EFFORT_IMPLEMENTER=high
LOOP_EFFORT_CRITIC=max

# Run history and repository profiles: <knowledge_dir>/<repo>/loop.toml
LOOP_KNOWLEDGE_DIR=~/andrey_personal_projects/MY-KNOWLEDGE-DATABASE/USEFUL_JOB_NOTES/agent_runs

# Rules of a particular project, if they are not in its repository; usually set in loop.toml
# LOOP_CONTEXT_FILE=

# Context fill of one step, tokens
LOOP_CTX_SOFT_TOKENS=120000
LOOP_CTX_HARD_TOKENS=150000

# Subscription limits, shares of 1
LOOP_RESERVE_5H=0.10
LOOP_RESERVE_7D=0.05
LOOP_START_ALLOWANCE_5H=0.2
LOOP_STEP_MARGIN=0.03

# Diff of one task, lines
LOOP_DIFF_SOFT_LINES=1000
LOOP_DIFF_HARD_LINES=1500

LOOP_FIX_ATTEMPTS=3
LOOP_REVIEW_EVERY=2
LOOP_REVIEW_ROUNDS=2
LOOP_PLAN_CRITIC_ROUNDS=2
LOOP_STEP_TIMEOUT_MIN=60
